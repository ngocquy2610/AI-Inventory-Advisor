# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory_advisor

# Environment: development, staging, production
ENVIRONMENT=development

# Service token for server-to-server authentication
SERVICE_TOKEN=changeme-secret-token

# Logging
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Forecast configuration
FORECAST_HORIZON_DAYS=30

# Tavily API key for news-aware forecasting
# Get your key at https://tavily.com
TAVILY_API_KEY=
NEWS_WEIGHT_FACTOR=0.15

# LLM provider (OpenAI-compatible — works with OpenAI, Ollama, LM Studio, etc.)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Simulation configuration
SIMULATION_ITERATIONS=1000

# Batch job configuration
BATCH_TIMEOUT_SECONDS=300